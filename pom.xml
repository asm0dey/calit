<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>site.asm0dey.calit</groupId>
  <artifactId>calit</artifactId>
  <version>${revision}</version>

  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <!-- Keep the compiled artifact version stable so metadata-only releases reuse Docker build layers. -->
    <revision>dev</revision>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- Quarkus @CheckedTemplate needs parameter names retained in bytecode. -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>4.0.1</quarkus.platform.version>
    <surefire-plugin.version>3.6.1</surefire-plugin.version>
    <jacoco-plugin.version>0.8.16</jacoco-plugin.version>
    <test-order-plugin.version>0.1.1</test-order-plugin.version>
    <sonar-maven-plugin.version>5.9.0.7382</sonar-maven-plugin.version>
    <assertj.version>3.27.7</assertj.version>
    <archunit.version>1.5.1</archunit.version>
    <ical4j.version>4.4.0</ical4j.version>

    <!-- SonarQube Cloud analysis (CI-based, via sonar-maven-plugin). The Maven scanner does
         NOT read sonar-project.properties; all analysis parameters live here. -->
    <sonar.organization>asm0dey</sonar.organization>
    <sonar.projectKey>asm0dey_calit</sonar.projectKey>
    <!-- Coverage from quarkus-jacoco (default report dir target/jacoco-report). -->
    <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/jacoco-report/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    <!-- Vendored from tesslio/good-oss-citizen's install-gate: fix its findings upstream, not in our copy. -->
    <sonar.exclusions>.github/scripts/**</sonar.exclusions>
    <!-- Duplication in the email layer is inherent to the type-safe @CheckedTemplate design, not
         copy/paste to refactor away (flat params were chosen over a view record on purpose — see
         docs/superpowers/specs/2026-07-02-typed-email-templates-design.md): each template redeclares
         the {@...} vars it uses (Qute has no cross-template decl sharing) and EmailService's
         per-event render methods/call-sites mirror those same param sets 1:1. Exclude both from
         duplication detection only; every other rule still applies. -->
    <sonar.cpd.exclusions>**/templates/email/*.html,**/email/EmailService.java</sonar.cpd.exclusions>
    <sonar.issue.ignore.multicriteria>e1,e2,e3,e4,e5</sonar.issue.ignore.multicriteria>
    <!-- e1: Flyway migrations are PostgreSQL, but Sonar analyses .sql with its Oracle PL/SQL engine
         and flags VARCHAR (suggesting the Oracle-only VARCHAR2). VARCHAR is correct in Postgres. -->
    <sonar.issue.ignore.multicriteria.e1.ruleKey>plsql:VarcharUsageCheck</sonar.issue.ignore.multicriteria.e1.ruleKey>
    <sonar.issue.ignore.multicriteria.e1.resourceKey>**/db/migration/*.sql</sonar.issue.ignore.multicriteria.e1.resourceKey>
    <!-- e2: S135 (at most one break/continue per loop) — early-continue guards are clearer; skip it. -->
    <sonar.issue.ignore.multicriteria.e2.ruleKey>java:S135</sonar.issue.ignore.multicriteria.e2.ruleKey>
    <sonar.issue.ignore.multicriteria.e2.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.e2.resourceKey>
    <!-- e3: _location.html is a Qute fragment always {#include}'d inside a parent <ul>; Sonar's HTML
         checker analyses the fragment in isolation and can't follow the include (false positive). -->
    <sonar.issue.ignore.multicriteria.e3.ruleKey>Web:ItemTagNotWithinContainerTagCheck</sonar.issue.ignore.multicriteria.e3.ruleKey>
    <sonar.issue.ignore.multicriteria.e3.resourceKey>**/templates/email/_location.html</sonar.issue.ignore.multicriteria.e3.resourceKey>
    <!-- e4: S107 (too many parameters) — the EmailService @CheckedTemplate methods mirror their
         template's variables 1:1 by design; a high param count IS the intended, build-validated contract. -->
    <sonar.issue.ignore.multicriteria.e4.ruleKey>java:S107</sonar.issue.ignore.multicriteria.e4.ruleKey>
    <sonar.issue.ignore.multicriteria.e4.resourceKey>**/email/EmailService.java</sonar.issue.ignore.multicriteria.e4.resourceKey>
    <!-- e5: S3252 (use static access for inherited static) fires on the Panache active-record idiom
         (Entity.findById/count/list) which is the intended, codebase-wide pattern — pure noise, suppress. -->
    <sonar.issue.ignore.multicriteria.e5.ruleKey>java:S3252</sonar.issue.ignore.multicriteria.e5.ruleKey>
    <sonar.issue.ignore.multicriteria.e5.resourceKey>**/*.java</sonar.issue.ignore.multicriteria.e5.resourceKey>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Pin ahead of quarkus-bom: 3.38.0 still ships jackson-core 2.22.0 (GHSA-r7wm-3cxj-wff9). -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>2.23.0</version>
      </dependency>
      <!-- Pin ahead of quarkus-bom 3.40.1 (byte-buddy 1.18.8, Java <= 26): on JDK 27 that version reads Hibernate's
           shared enhancer advice via the non-thread-safe Class-File API and augmentation fails at random.
           1.18.10+ knows Java 27 and stays on ASM. Guarded by EntityEnhancerReaderTest; drop once the BOM catches up. -->
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy</artifactId>
        <version>1.18.17</version>
      </dependency>
      <!-- Pin ahead of google-api-client 2.9.1, which ships guava 33.6.0-jre (CVE-2026-102554, image Trivy gate). -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>33.8.0-jre</version>
      </dependency>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest-jackson</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-hibernate-orm-panache</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-jdbc-postgresql</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-flyway</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-smallrye-health</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-arc</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-mailer</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-scheduler</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-qute</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-rest-qute</artifactId></dependency>
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-reactive-routes</artifactId></dependency>
    <!-- CalDAV: parse iCalendar data and expand recurrences client-side. -->
    <dependency>
      <groupId>org.mnode.ical4j</groupId>
      <artifactId>ical4j</artifactId>
      <version>${ical4j.version}</version>
    </dependency>
    <!-- java.awt in the native image: renders the social-preview card. Needs runtime .so files and
         a font on disk in the container - see Dockerfile.native. -->
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-awt</artifactId></dependency>
    <!-- Core security runtime: provides the IdentityProvider SPI + QuarkusSecurityIdentity
         for our custom AppUserIdentityProvider. security-jpa was dropped (its generated
         Elytron provider raced ours and intermittently rejected valid logins). -->
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-security</artifactId></dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-oidc</artifactId>
    </dependency>
    <!-- CSRF defense-in-depth for state-changing form POSTs (SEC-SECRET-04). Disabled in %test. -->
    <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-rest-csrf</artifactId>
    </dependency>

    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-junit5</artifactId><scope>test</scope></dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Code coverage: quarkus-jacoco writes target/jacoco-report/jacoco.xml (consumed by SonarQube) at the end of
         the @QuarkusTest run. It only instruments code loaded by the QuarkusClassLoader; plain-JUnit tests are
         covered by the jacoco-maven-plugin agent below, which writes to the same jacoco-quarkus.exec so the one
         report merges both (Quarkus "Coverage for tests not using @QuarkusTest"). -->
    <dependency><groupId>io.quarkus</groupId><artifactId>quarkus-jacoco</artifactId><scope>test</scope></dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-security</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-test-oidc-server</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency><groupId>io.rest-assured</groupId><artifactId>rest-assured</artifactId><scope>test</scope></dependency>
    <!-- Google Calendar sync (Plan 2) -->
    <dependency>
      <groupId>com.google.api-client</groupId>
      <artifactId>google-api-client</artifactId>
      <version>2.9.2</version>
    </dependency>
    <dependency>
      <groupId>com.google.oauth-client</groupId>
      <artifactId>google-oauth-client</artifactId>
      <version>1.39.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.apis</groupId>
      <artifactId>google-api-services-calendar</artifactId>
      <version>v3-rev20261030-2.9.2</version>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5-mockito</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit-component</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.87</version>
    </dependency>
    <dependency>
      <groupId>org.alexmond</groupId>
      <artifactId>notify4j-core</artifactId>
      <version>1.2.0</version>
    </dependency>
    <!-- ALTCHA server-side challenge creation + verification (v1 hashcash protocol). -->
    <dependency>
        <groupId>org.altcha</groupId>
        <artifactId>altcha</artifactId>
        <version>2.1.1</version>
    </dependency>
    <!-- ALTCHA widget JS (npm package, via WebJar on Maven Central — no external repo needed).
         Served version-less at /webjars/altcha/... by quarkus-web-dependency-locator.
         3.4.0 never detects v1 challenges (what AltchaResource mints), so no one could book;
         renovate.json skips it, 3.4.1 fixes it. -->
    <dependency>
        <groupId>org.webjars.npm</groupId>
        <artifactId>altcha</artifactId>
        <version>3.7.0</version>
        <scope>runtime</scope>
    </dependency>
    <!-- altcha's hash-wasm dependency is declared as a version RANGE; pin a concrete version so the
         Docker build's `dependency:go-offline` resolves it deterministically from Central instead of
         re-resolving the range. (An earlier mvnpm mirror of this artifact had a flaky origin; the
         WebJar on Central does not, but the pin keeps go-offline stable regardless.) -->
    <dependency>
        <groupId>org.webjars.npm</groupId>
        <artifactId>hash-wasm</artifactId>
        <version>4.13.0</version>
        <scope>runtime</scope>
    </dependency>
    <!-- Version-less static paths for the WebJar assets above. -->
    <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-web-dependency-locator</artifactId>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Version pin for the CI-invoked goal
             org.sonarsource.scanner.maven:sonar-maven-plugin:sonar (see .github/workflows/ci.yml). -->
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${sonar-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <configuration>
          <!-- One reused fork for ALL @QuarkusTest classes: Quarkus keeps a single running app and a
               single Dev Services (Testcontainers) Postgres across same-profile tests, instead of
               cold-booting an app + a NEW container per class (which made the suite take minutes).
               @TestProfile classes still trigger an in-JVM restart; the generous heap (and uncapped
               metaspace — Quarkus augmentation is metaspace-heavy) absorbs the few extra classloaders.
               The exit timeout is raised so a slow Vert.x/Quarkus shutdown isn't misreported. -->
          <reuseForks>true</reuseForks>
          <!-- *IT classes need the packaged app and run under failsafe only; this keeps them out when
               a test-order run (or -Dtest) hands surefire an IT class by name. -->
          <excludedGroups>integration</excludedGroups>
          <argLine>@{argLine} -Xms512m -Xmx6g</argLine>
          <forkedProcessExitTimeoutInSeconds>120</forkedProcessExitTimeoutInSeconds>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <!-- reuseForks=true runs many @QuarkusTest classes (and @TestProfile restarts) in one JVM;
                 accumulate their coverage into one data file instead of overwriting per class. -->
            <quarkus.jacoco.reuse-data-file>true</quarkus.jacoco.reuse-data-file>
            <!-- quarkus-jacoco offline-instruments @QuarkusComponentTest classes; JaCoCo's offline runtime
                 reads its destination from jacoco-agent.* properties and would otherwise write ./jacoco.exec. -->
            <jacoco-agent.destfile>${project.build.directory}/jacoco-quarkus.exec</jacoco-agent.destfile>
            <jacoco-agent.append>true</jacoco-agent.append>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <!-- JaCoCo agent for plain-JUnit tests (sets @{argLine}); skips QuarkusClassLoader classes, which
             quarkus-jacoco instruments, and appends to its data file so its report includes these tests. -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-plugin.version}</version>
        <executions>
          <execution>
            <id>default-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <exclClassLoaders>*QuarkusClassLoader</exclClassLoaders>
              <destFile>${project.build.directory}/jacoco-quarkus.exec</destFile>
              <append>true</append>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Runs @QuarkusIntegrationTest classes: Quarkus packages the app (quarkus:build already
             ran in an earlier phase) and this plugin boots the packaged quarkus-app/quarkus-run.jar
             as a SEPARATE process, then runs *IT.java against it over real HTTP. This is the
             packaging check for calit-o89d: it proves the runtime AWT/font stack works against the
             actual build artifact, not just the in-JVM @QuarkusTest classpath. Standard Quarkus
             wiring (integration-test + verify goals bound to their default phases). -->
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${surefire-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
            <configuration>
              <systemPropertyVariables>
                <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                <maven.home>${maven.home}</maven.home>
              </systemPropertyVariables>
              <!-- The launched quarkus-run.jar boots as %prod (the packaged default), which requires
                   the same env vars .github/workflows/ci.yml's smoke test supplies to a real prod
                   container. MAIL_FROM/USERNAME/PASSWORD stay unset on purpose, same as that smoke
                   test: QUARKUS_MAILER_MOCK=true short-circuits the real SMTP client before those are
                   read. DB_* is not needed here: the GLOBAL test resource PostgresResource starts (or reuses)
                   the test Postgres and hands its JDBC URL/credentials to the launched app. SIGNUP_ENABLED lets
                   every IT create its own owner through /signup once the first one took /setup. -->
              <environmentVariables>
                <SESSION_ENCRYPTION_KEY>it-session-key-0123456789-abcdef</SESSION_ENCRYPTION_KEY>
                <TOKEN_ENCRYPTION_KEY>1111111111111111111111111111111111111111111111111111111111111111</TOKEN_ENCRYPTION_KEY>
                <APP_BASE_URL>http://localhost:8081</APP_BASE_URL>
                <MAIL_HOST>localhost</MAIL_HOST>
                <QUARKUS_MAILER_MOCK>true</QUARKUS_MAILER_MOCK>
                <GOOGLE_OAUTH_CLIENT_ID>dummy</GOOGLE_OAUTH_CLIENT_ID>
                <GOOGLE_OAUTH_CLIENT_SECRET>dummy</GOOGLE_OAUTH_CLIENT_SECRET>
                <GOOGLE_OAUTH_STATE_SECRET>it-state-secret-0123456789-abcdef</GOOGLE_OAUTH_STATE_SECRET>
                <SIGNUP_ENABLED>true</SIGNUP_ENABLED>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <version>10.0.1</version>
        <executions>
          <execution>
            <id>get-the-git-infos</id>
            <goals>
              <goal>revision</goal>
            </goals>
            <phase>initialize</phase>
          </execution>
        </executions>
        <configuration>
          <generateGitPropertiesFile>true</generateGitPropertiesFile>
          <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
          <!-- Shallow CI checkouts / archive builds have no .git: degrade, don't fail. -->
          <failOnNoGitDirectory>false</failOnNoGitDirectory>
          <abbrevLength>7</abbrevLength>
          <includeOnlyProperties>
            <property>^git\.build\.version$</property>
            <property>^git\.commit\.id\.abbrev$</property>
          </includeOnlyProperties>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.12.0</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <toggleOffOn />
            <!-- CleanThat refactors first, Prince of Space formats the result. -->
            <cleanthat>
              <!-- Pinned: CleanThat 2.23-2.25 crashed in UseDiamondOperator on nested records
                   (solven-eu/cleanthat#954); fixed in 2.26, which spotless 3.7.0 does not yet bundle. -->
              <version>2.26</version>
              <sourceJdk>25</sourceJdk>
              <mutators>
                <mutator>SafeAndConsensual</mutator>
                <mutator>UseDiamondOperator</mutator>
                <mutator>UseDiamondOperatorJdk8</mutator>
                <mutator>LambdaIsMethodReference</mutator>
                <mutator>LambdaReturnsSingleStatement</mutator>
                <mutator>UnnecessaryLambdaEnclosingParameters</mutator>
                <mutator>PrimitiveWrapperInstantiation</mutator>
                <mutator>UnnecessarySemicolon</mutator>
                <mutator>UnnecessaryImport</mutator>
                <mutator>UnnecessaryFullyQualifiedName</mutator>
                <mutator>UsePredefinedStandardCharset</mutator>
                <mutator>RemoveNewStringConstructor</mutator>
                <mutator>EnumsWithoutEquals</mutator>
                <mutator>EmptyControlStatement</mutator>
                <mutator>RedundantLogicalComplementsInStream</mutator>
                <mutator>OptionalMapIdentity</mutator>
                <mutator>StreamMapIdentity</mutator>
                <mutator>ObjectsHashCodePrimitive</mutator>
                <mutator>LocalVariableTypeInference</mutator>
                <mutator>UseTextBlocks</mutator>
              </mutators>
            </cleanthat>
            <princeOfSpace>
              <version>2.3.1</version>
              <lineLength>120</lineLength>
              <javaLanguageLevel>25</javaLanguageLevel>
            </princeOfSpace>
            <formatAnnotations />
            <removeUnusedImports />
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <!-- Native smoke: `./mvnw verify -Pnative` compiles the native binary in a glibc Liberica NIK
           container (glibc, not Dockerfile.native's musl builder, so the binary runs on the Ubuntu CI
           runner; same NIK version), skips surefire, and failsafe runs every *IT against
           native.image.path. CI runs this in the native-it job. Flags come from application.properties.
           Run Maven itself on JDK 25 (the NIK version): Qute generates resolvers for the build JDK's own
           String/Map methods, and native-image 25 fails on JDK 27-only ones (String.compareToFoldCase). -->
      <id>native</id>
      <properties>
        <quarkus.native.enabled>true</quarkus.native.enabled>
        <quarkus.native.container-build>true</quarkus.native.container-build>
        <!-- the NIK image has no ENTRYPOINT and works in /, while Quarkus passes only native-image
             arguments and mounts the build at /project (Mandrel images set both) -->
        <!-- -Ob: quick-build mode, a less-optimised but much faster native-image compile. The smoke ITs
             look for missing reflection/resources/init, which optimisation does not change; the shipped
             image (Dockerfile.native) is still fully optimised. Appended, so the shared list stays intact. -->
        <quarkus.native.additional-build-args-append>-Ob</quarkus.native.additional-build-args-append>
        <quarkus.native.container-runtime-options>--entrypoint=native-image,--workdir=/project</quarkus.native.container-runtime-options>
        <quarkus.native.builder-image>bellsoft/liberica-native-image-kit-container:jdk-25-nik-25.0.3-glibc@sha256:9826a9b3de952a6e16aada3251884af6055f3fe72838f69841a5026092f3d511</quarkus.native.builder-image>
      </properties>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skipTests>true</skipTests>
            </configuration>
          </plugin>
          <plugin>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <configuration>
                  <environmentVariables>
                    <!-- AWT dlopen()s the JDK .so files native-image emits beside the build; the image
                         copies them to /app/lib (Dockerfile.native), here they stay in target/. -->
                    <LD_LIBRARY_PATH>${project.build.directory}/${project.build.finalName}-native-image-source-jar</LD_LIBRARY_PATH>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>affected</id>
      <build>
        <plugins>
          <plugin>
            <!-- Selective test runs: opt-in with -Paffected: `./mvnw -Paffected test-order:affected test` runs only the
                 tests the uncommitted change can reach, from an index learned on the first
                 `./mvnw -Paffected test` (stored in the git-ignored .test-order/). <extensions> is required
                 for its agent. Kept out of the default build: in learn mode its prepare goal leaves a
                 non-String system property that breaks a later quarkus:build (NPE in Narayana's
                 applySystemProperties), so CI and image builds must not load it. -->
            <groupId>me.bechberger</groupId>
            <artifactId>test-order-maven-plugin</artifactId>
            <version>${test-order-plugin.version}</version>
            <extensions>true</extensions>
            <executions>
              <execution>
                <goals>
                  <goal>prepare</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
