{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "docker": {
    "pinDigests": true
  },
  "packageRules": [
    {
      "description": "One PR for everything that is not a major bump. Majors stay on their own, and a security update still opens its own PR regardless of this rule.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "bump"
      ],
      "groupName": "all non-major dependencies"
    }
  ],
  "customManagers": [
    {
      "description": "Keep the Quarkus version quoted in README.md (badge) and CLAUDE.md in step with quarkus.platform.version in pom.xml.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^CLAUDE\\.md$/"
      ],
      "matchStrings": [
        "badge/Quarkus-(?<currentValue>\\d+\\.\\d+\\.\\d+)-",
        "on Quarkus (?<currentValue>\\d+\\.\\d+\\.\\d+) /"
      ],
      "depNameTemplate": "io.quarkus.platform:quarkus-bom",
      "datasourceTemplate": "maven"
    },
    {
      "description": "Bump the Liberica JDK in .sdkmanrc (read by sdkman and mise) from sdkman's own identifier list, so proposed values are real sdkman ids.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.sdkmanrc$/"
      ],
      "matchStrings": [
        "java=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "java",
      "datasourceTemplate": "custom.sdkman-java",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+(?<build>\\d+)(?:\\.(?<revision>\\d+))?(?<compatibility>-librca)$"
    }
  ],
  "customDatasources": {
    "sdkman-java": {
      "description": "sdkman's Java candidate list: one comma-separated line of identifiers.",
      "defaultRegistryUrlTemplate": "https://api.sdkman.io/2/candidates/java/linuxx64/versions/all",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [$map($split($join(releases.version, \",\"), \",\"), function($v) { {\"version\": $v} })]}"
      ]
    }
  }
}
