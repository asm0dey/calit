# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32

# --- CSS stage: compile Tailwind + daisyUI with Bun (no JS ships at runtime) ---
FROM oven/bun:1@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS css
WORKDIR /app
COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --ignore-scripts
COPY src/main/css/ src/main/css/
COPY src/main/resources/templates/ src/main/resources/templates/
RUN bun run css:build

# --- Build stage: BellSoft Liberica Native Image Kit on Alpaquita musl ---
# The builder OS is musl, so native-image compiles a musl-linked binary natively:
# no --libc=musl flag, no manual musl toolchain install (which the UBI Mandrel image needs).
FROM bellsoft/liberica-native-image-kit-container:jdk-25-nik-25.0.3-musl@sha256:caa32c436d7d1a1f85066453377c3c6fc5478488a99c7e2d25baf176cfd24b1c AS build
WORKDIR /build

# Warm the dependency cache on the POM first so source-only edits don't re-download everything.
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -q -DskipTests dependency:go-offline

COPY src/ src/
# Overlay the Bun-compiled stylesheet (gitignored, so not in the COPY above).
COPY --from=css /app/src/main/resources/META-INF/resources/calit.css src/main/resources/META-INF/resources/calit.css
# Inject build metadata so the footer shows the real version + commit instead of "dev".
ARG APP_VERSION=dev
ARG GIT_COMMIT=dev
RUN printf 'git.build.version=%s\ngit.commit.id.abbrev=%s\n' "$APP_VERSION" "$GIT_COMMIT" \
    > src/main/resources/git.properties
# Native compile. Builder is musl → binary is musl-linked. Heavy: needs several GB RAM.
# -H:Preserve=package=... keeps full reflection metadata for the Google API client model
# classes. They are (de)serialized reflectively (no-arg ctor + @Key fields) but ship NO native
# metadata in their jars (google-api-client / google-oauth-client / google-api-services-calendar),
# so without this the OAuth token + freeBusy JSON parsing crashes at runtime in the native image.
# --initialize-at-build-time=java.awt.Color: discovered by this change (calit-o89d) -- fails the
# BUILD, not a request. CardRenderer's static final Color fields land in the image heap because
# CardRenderer is a CDI bean initialized at build time; Color defaults to run-time init (its static
# initializer calls Toolkit.loadLibraries() plus a conditional initIDs() when not headless), and
# GraalVM refuses run-time-initialized types in a build-time heap.
# Safe here: Color's frozen state is plain RGB ints, and build + run both happen in equally-headless
# Linux containers -- proven empirically (JVM vs native /og.png and /og/admin.png output is
# byte-for-byte SHA-256 identical).
# Fragile: the flag names java.awt.Color specifically. Any future static final AWT-typed field on
# CardRenderer (Font, GradientPaint, BasicStroke, ...) reproduces the identical fatal error,
# discoverable only by a failed native build. The durable alternative is
# --initialize-at-run-time=site.asm0dey.calit.web.og.CardRenderer, covering any future AWT field in
# one stroke -- not taken: CardRenderer is a CDI bean and Quarkus initializes bean classes at build
# time by design, so forcing run-time init fights that machinery (untested) to guard a field nobody
# has written yet. The failure mode is loud (build fails outright), so this comment is the mitigation
# until a new AWT-typed static field actually appears -- then reach for the class-level flag instead.
# Each of these is a separate comma item (Quarkus splits additional-build-args on commas).
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -DskipTests package -Dquarkus.native.enabled=true \
    "-Dquarkus.native.additional-build-args=-H:Preserve=package=com.google.api.services.calendar.model,-H:Preserve=package=com.google.api.client.auth.oauth2,-H:Preserve=package=com.google.api.client.googleapis.json,-H:Preserve=package=com.google.api.client.googleapis.auth.oauth2,-H:Preserve=package=com.google.api.client.json.webtoken,--initialize-at-run-time=org.altcha.altcha.v1.Altcha,--initialize-at-build-time=java.awt.Color"

# --- Runtime stage: Alpaquita musl base (~3.9MB) — no JDK, just the native binary ---
FROM bellsoft/alpaquita-linux-base:stream-musl@sha256:d0bf46cb446f36eccacad2604d858537e4455ee2b663729c1f588ca6bb5eca33 AS runtime
WORKDIR /app
# ca-certificates: outbound TLS to Google API + SMTP. zlib: the binary links libz.so.1.
# freetype + fontconfig: required by quarkus-awt for native mode, per its own guide. The font
# package goes beyond what that guide lists and is NOT decorative: with no font file anywhere the
# JDK font manager fails to initialise ("Fontconfig head is null"), and that breaks Font.createFont
# even for a TTF embedded in the binary. Moving to a hardened/distroless base (calit-gabg) requires
# switching this to a copy-from-builder stack instead: libfreetype.so.6, libfontconfig.so.1,
# libexpat, libbz2, libpng16, libbrotlidec, libbrotlicommon, /etc/fonts, the font files, and
# /var/cache/fontconfig with fc-cache run in the builder stage. Font.createFont(InputStream) also
# spills to a temp file, so a read-only root filesystem needs a tmpfs mount at /tmp or card
# rendering fails at request time regardless of the font stack.
RUN apk add --no-cache ca-certificates zlib freetype fontconfig font-dejavu-core && update-ca-certificates
COPY --chown=1001:1001 --from=build /build/target/*-runner /app/application
# AWT in a native image dlopen()s these JDK libraries at runtime; native-image emits them beside the
# binary instead of linking them in, so they must ship with it.
COPY --chown=1001:1001 --from=build /build/target/*-native-image-source-jar/*.so /app/lib/
ENV LD_LIBRARY_PATH=/app/lib
USER 1001
EXPOSE 8080
ENV QUARKUS_HTTP_HOST=0.0.0.0 \
    QUARKUS_PROFILE=prod
ENTRYPOINT ["./application"]
