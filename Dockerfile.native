# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e

# --- CSS stage: compile Tailwind + daisyUI with Bun (no JS ships at runtime) ---
FROM oven/bun:1@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS css
WORKDIR /app
COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile --ignore-scripts
COPY src/main/css/ src/main/css/
COPY src/main/resources/templates/ src/main/resources/templates/
RUN bun run css:build

# --- Build stage: BellSoft Liberica Native Image Kit on Alpaquita musl ---
# The builder OS is musl, so native-image compiles a musl-linked binary natively:
# no --libc=musl flag, no manual musl toolchain install (which the UBI Mandrel image needs).
FROM bellsoft/liberica-native-image-kit-container:jdk-25-nik-25.0.3-musl@sha256:caa32c436d7d1a1f85066453377c3c6fc5478488a99c7e2d25baf176cfd24b1c AS build
WORKDIR /build

# Warm the dependency cache on the POM first so source-only edits don't re-download everything.
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -q -DskipTests dependency:go-offline

COPY src/main/ src/main/
# Overlay the Bun-compiled stylesheet (gitignored, so not in the COPY above).
COPY --from=css /app/src/main/resources/META-INF/resources/calit.css src/main/resources/META-INF/resources/calit.css
# Native compile. Builder is musl → binary is musl-linked. Heavy: needs several GB RAM.
# native-image flags (-H:Preserve..., --initialize-at-...) and why each is needed live in
# src/main/resources/application.properties (quarkus.native.additional-build-args), shared with -Pnative.
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -DskipTests package -Dquarkus.native.enabled=true

# --- Font stack donor: the distroless runtime below has no apk, so install + cache fonts here ---
# freetype + fontconfig: required by quarkus-awt for native mode, per its own guide. The font
# package goes beyond what that guide lists and is NOT decorative: with no font file anywhere the
# JDK font manager fails to initialise ("Fontconfig head is null"), and that breaks Font.createFont
# even for a TTF embedded in the binary. Packages deliberately unpinned, same reasoning as the
# fontstack stage in Dockerfile (CVE-rich C parsers; Trivy + the CI smoke test gate the result).
FROM bellsoft/alpaquita-linux-base:stream-musl@sha256:1bd4c2dcd3c29e6a3fde3568a979237f911a27f0622751e63333df8a8684a736 AS fontstack
RUN apk add --no-cache freetype fontconfig font-dejavu-core && fc-cache -f

# --- Runtime stage: BellSoft hardened distroless Alpaquita musl — no shell, no apk, just the binary ---
# The base already ships musl and libz.so.1 (the binary links it). No ca-certificates: a native
# image uses the JDK trust store captured at build time, not the system CA bundle (same as the
# JVM image, whose distroless base has none either).
FROM bellsoft/hardened-base:distroless-musl@sha256:0baa55f46dc01ff520b17fd57146fa00829132806f8fcdb2608040e3225d665c AS runtime
WORKDIR /app
# Only the SONAMEs libfontmanager.so's NEEDED entries reference; see Dockerfile for why.
COPY --from=fontstack \
    /usr/lib/libfreetype.so.6 \
    /usr/lib/libfontconfig.so.1 \
    /usr/lib/libexpat.so.1 \
    /usr/lib/libbz2.so.1 \
    /usr/lib/libpng16.so.16 \
    /usr/lib/libbrotlidec.so.1 \
    /usr/lib/libbrotlicommon.so.1 \
    /usr/lib/
COPY --from=fontstack /etc/fonts/ /etc/fonts/
COPY --from=fontstack /usr/share/fonts/ /usr/share/fonts/
COPY --from=fontstack /var/cache/fontconfig/ /var/cache/fontconfig/
# Font.createFont(InputStream) spills to a temp file, so a read-only root filesystem needs a
# tmpfs mount at /tmp or card rendering fails at request time regardless of the font stack.
COPY --chown=1001:1001 --from=build /build/target/*-runner /app/application
# AWT in a native image dlopen()s these JDK libraries at runtime; native-image emits them beside the
# binary instead of linking them in, so they must ship with it.
COPY --chown=1001:1001 --from=build /build/target/*-native-image-source-jar/*.so /app/lib/
ENV LD_LIBRARY_PATH=/app/lib
USER 1001
EXPOSE 8080
ARG APP_VERSION=dev
ARG GIT_COMMIT=dev
ENV QUARKUS_HTTP_HOST=0.0.0.0 \
    QUARKUS_PROFILE=prod \
    APP_VERSION=${APP_VERSION} \
    GIT_COMMIT=${GIT_COMMIT}
ENTRYPOINT ["./application"]
